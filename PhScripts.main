-- PhHub | Blox Fruits + 99 Noites
-- Versão 2.0 - UI Corrigida e Funcional

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

getgenv().PhHub = getgenv().PhHub or {}

-- ==================== CONFIG ====================
local Config = {
    AutoSave = true,
    Notifications = true,
}

-- ==================== FLUENT UI ====================
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "PhHub - Blox Fruits & 99 Noites",
    SubTitle = "by Grok • Versão 2.0",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.RightControl
})

-- ==================== ABAS ====================
local Tabs = {
    Home       = Window:AddTab({ Title = "🏠 Home", Icon = "home" }),
    BloxFruits = Window:AddTab({ Title = "🍎 Blox Fruits", Icon = "apple" }),
    Noites     = Window:AddTab({ Title = "🌙 99 Noites", Icon = "moon" }),
    Player     = Window:AddTab({ Title = "👤 Player", Icon = "user" }),
    Settings   = Window:AddTab({ Title = "⚙️ Settings", Icon = "settings" })
}

-- ==================== HOME ====================
Tabs.Home:AddParagraph({
    Title = "Bem-vindo ao PhHub",
    Content = "Script moderno para Blox Fruits e 99 Noites.\nUse com responsabilidade!"
})

Tabs.Home:AddButton({
    Title = "Destroy GUI",
    Callback = function()
        Window:Destroy()
    end
})

Tabs.Home:AddButton({
    Title = "Rejoin Server",
    Callback = function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
})

-- ==================== BLOX FRUITS ====================
local BFSection = Tabs.BloxFruits:AddSection("Auto Farm")

BFSection:AddToggle({
    Title = "Auto Farm Level",
    Default = false,
    Callback = function(Value)
        getgenv().AutoFarmLevel = Value
    end
})

BFSection:AddToggle({ Title = "Auto Farm Mastery", Default = false, Callback = function(v) getgenv().AutoFarmMastery = v end })
BFSection:AddToggle({ Title = "Auto Farm Beli", Default = false, Callback = function(v) getgenv().AutoFarmBeli = v end })
BFSection:AddToggle({ Title = "Auto Raids", Default = false, Callback = function(v) getgenv().AutoRaids = v end })
BFSection:AddToggle({ Title = "Auto Kill Bosses", Default = false, Callback = function(v) getgenv().AutoKillBosses = v end })
BFSection:AddToggle({ Title = "Auto Farm Bounty", Default = false, Callback = function(v) getgenv().AutoFarmBounty = v end })
BFSection:AddToggle({ Title = "Auto Quest", Default = false, Callback = function(v) getgenv().AutoQuest = v end })
BFSection:AddToggle({ Title = "Auto Farm Fruits", Default = false, Callback = function(v) getgenv().AutoFarmFruits = v end })

BFSection:AddDropdown({
    Title = "Dificuldade Raid",
    Values = {"Easy", "Medium", "Hard", "Nightmare"},
    Default = "Medium",
    Callback = function(Value)
        getgenv().RaidDifficulty = Value
    end
})

-- Kill Aura
BFSection:AddToggle({ Title = "Kill Aura", Default = false, Callback = function(v) getgenv().KillAura = v end })
BFSection:AddSlider({
    Title = "Kill Aura Range",
    Min = 10,
    Max = 100,
    Default = 30,
    Callback = function(v) getgenv().KillAuraRange = v end
})

-- ==================== 99 NOITES ====================
local NoitesSection = Tabs.Noites:AddSection("Auto Farm")

NoitesSection:AddToggle({ Title = "Auto Farm Dias (Fogueira)", Default = false, Callback = function(v) getgenv().AutoFarmDias = v end })
NoitesSection:AddToggle({ Title = "Auto Craft", Default = false, Callback = function(v) getgenv().AutoCraft = v end })
NoitesSection:AddToggle({ Title = "Auto Salvar Crianças", Default = false, Callback = function(v) getgenv().AutoSaveKids = v end })
NoitesSection:AddToggle({ Title = "Kill Aura", Default = false, Callback = function(v) getgenv().NoitesKillAura = v end })

NoitesSection:AddSlider({
    Title = "Kill Aura Range",
    Min = 5,
    Max = 50,
    Default = 20,
    Callback = function(v) getgenv().NoitesKillAuraRange = v end
})

NoitesSection:AddToggle({ Title = "Auto Pegar Itens", Default = false, Callback = function(v) getgenv().AutoPickupItems = v end })

-- ==================== PLAYER ====================
local Movement = Tabs.Player:AddSection("Movement")

Movement:AddToggle({ Title = "Fly", Default = false, Callback = function(v) getgenv().Fly = v end })
Movement:AddToggle({ Title = "NoClip", Default = false, Callback = function(v) getgenv().NoClip = v end })
Movement:AddToggle({ Title = "Anti-AFK", Default = true, Callback = function(v) getgenv().AntiAFK = v end })

Movement:AddSlider({
    Title = "WalkSpeed",
    Min = 16,
    Max = 500,
    Default = 16,
    Callback = function(v)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = v
        end
    end
})

Movement:AddSlider({
    Title = "JumpPower",
    Min = 50,
    Max = 500,
    Default = 50,
    Callback = function(v)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.JumpPower = v
        end
    end
})

-- ==================== SETTINGS ====================
Tabs.Settings:AddToggle({
    Title = "Notificações",
    Default = Config.Notifications,
    Callback = function(Value)
        Config.Notifications = Value
    end
})

Tabs.Settings:AddButton({
    Title = "Salvar Config",
    Callback = function()
        print("Config salva (implemente save real se quiser)")
    end
})

-- ==================== LOOP PRINCIPAL ====================
task.spawn(function()
    while task.wait(0.1) do
        -- Anti-AFK
        if getgenv().AntiAFK then
            pcall(function()
                local vu = game:GetService("VirtualUser")
                vu:Button2Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                task.wait(0.1)
                vu:Button2Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
            end)
        end

        -- NoClip
        if getgenv().NoClip and LocalPlayer.Character then
            for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end

        -- Outras lógicas de farm aqui...
    end
end)

-- ==================== NOTIFICAÇÃO FINAL ====================
Fluent:Notify({
    Title = "PhHub",
    Content = "Script carregado com sucesso! Todas as abas devem aparecer agora.",
    Duration = 6
})

print("✅ PhHub v2.0 carregado!")
